# ============================================================
# Environment Variables — DO NOT COMMIT THIS FILE
# Copy this to .env and fill in your real values.
# ============================================================

# European Patent Office (EPO) Open Patent Services (OPS) API Keys
# Get yours at: https://developers.epo.org/
EPO_CONSUMER_KEY=your_consumer_key_here
EPO_CONSUMER_SECRET=your_consumer_secret_here

# Opik / Comet.com Observability
OPIK_API_KEY=your_comet_api_key_here
OPIK_WORKSPACE=your_comet_workspace_name
OPIK_PROJECT_NAME=ai-perception-rag
ENABLE_OPIK=true
